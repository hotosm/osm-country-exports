# Consumed by systemd EnvironmentFile=.env 
# For local dev:  set -a; source .env; set +a

OEX_DATA_DIR=

# HDX
HDX_API_KEY=
HDX_OWNER_ORG=
HDX_MAINTAINER=

OEX_S3_BUCKET=production-raw-data-api

# AWS_PROFILE=admin

# DuckDB memory ceiling, GB. Unset = 60% of total RAM.
# OEX_MEMORY_GB=18

# Tasking Manager exports: planet PBF (local path or s3:// URL)
TM_PBF=
TM_SANDBOX_PBF=
