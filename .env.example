# Load into the shell with: set -a; source .env; set +a

# Where outputs and the planet go; the repo folder when unset.
# OEX_DATA_DIR=/mnt/data

# HDX
HDX_API_KEY=
HDX_OWNER_ORG=
HDX_MAINTAINER=

OEX_S3_BUCKET=production-raw-data-api

# AWS_PROFILE=admin

# DuckDB memory ceiling, GB. Unset = 60% of total RAM.
# OEX_MEMORY_GB=18

# Tasking Manager sandbox: folder of dated daily exports; the newest is used
TM_SANDBOX_PBF=s3://<bucket>/exports/
